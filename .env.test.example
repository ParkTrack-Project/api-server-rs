# Test-only PostgreSQL, separate from the application/production server.
# Copy to .env.test and set the password of your local test instance.
# The safety guard requires a loopback host and these exact user/database names.
# Start PostgreSQL separately, then run: bash scripts/test.sh
TEST_DATABASE_URL=postgres://sqlx_test:replace_with_local_test_password@127.0.0.1:55433/api_server_rust_tests
